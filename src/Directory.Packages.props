<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- The only packages AngleSharp itself ships a dependency on: CodePages on .NET Standard,
       System.Memory on the .NET Framework. `dotnet pack` publishes these versions verbatim, so
       changing one changes the package's dependency range. -->
  <ItemGroup Label="AngleSharp">
    <PackageVersion Include="System.Memory" Version="4.5.5" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <!-- The DOM registration generator ships inside the AngleSharp package (analyzers/dotnet/cs), so
       every consumer's compiler loads it. Pinned to the Roslyn of the .NET 8 SDK: a newer one makes
       older compilers warn (CS9057) for every consumer, although only an opting-in library uses it. -->
  <ItemGroup Label="AngleSharp.Generators">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup Label="Build-time only (PrivateAssets, never packaged)">
    <PackageVersion Include="ConfigureAwaitChecker.Analyzer" Version="5.0.0.1" />
    <PackageVersion Include="Nullable" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Net.Http" Version="2.2.29" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="System.Reflection.DispatchProxy" Version="4.7.1" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="CsQuery" Version="1.3.5-beta5" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>
</Project>
