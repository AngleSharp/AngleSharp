<Project Sdk="Microsoft.NET.Sdk">
  <!-- The source generator turning the DOM attributes of a library into a DomRegistration. It is no
       package of its own: AngleSharp.Core.csproj packs it into the AngleSharp package as an analyzer,
       so a library gets the generator matching the contract it compiles against. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- an analyzer is loaded by the compiler, which needs no strong name and resolves it by path -->
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
